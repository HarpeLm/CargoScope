{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HarpeLm/CargoScope/blob/main/docs/schema/report-v1.json",
  "title": "CargoScope JSON report, format version 1",
  "description": "Output of `cargoscope scan --format json`. See docs/json-report.md for the compatibility policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "tool_version",
    "target",
    "checks",
    "advisory_database",
    "registry",
    "advisories",
    "packages",
    "unused",
    "policy",
    "warnings"
  ],
  "properties": {
    "format_version": { "const": 1 },
    "tool_version": { "type": "string" },
    "target": { "type": "string", "description": "Scanned directory, as given on the command line." },
    "checks": {
      "description": "Checks that ran (see --checks). Data of checks that did not run is empty or null.",
      "type": "array",
      "items": { "enum": ["inventory", "advisories", "unused", "licenses", "versions", "policy", "unsafe"] }
    },
    "advisory_database": { "$ref": "#/$defs/data_source" },
    "registry": { "$ref": "#/$defs/data_source" },
    "advisories": { "type": "array", "items": { "$ref": "#/$defs/advisory" } },
    "packages": { "type": "array", "items": { "$ref": "#/$defs/package" } },
    "unused": { "type": "array", "items": { "$ref": "#/$defs/unused" } },
    "duplicates": {
      "description": "Crates resolved in more than one version (packages of the project excluded), by name. Added in CargoScope 0.3.0.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "versions"],
        "properties": {
          "name": { "type": "string" },
          "versions": { "description": "Oldest first.", "type": "array", "minItems": 2, "items": { "type": "string" } }
        }
      }
    },
    "direct_weights": {
      "description": "Direct dependencies, heaviest first: `exclusive` packages would leave the tree if no member depended on it directly (itself included); `tree` packages are in its own tree (itself included). Added in CargoScope 0.4.0.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "kinds", "exclusive", "tree"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "kinds": { "description": "Sections under which the project declares it (empty when unknown).", "type": "array", "items": { "enum": ["normal", "dev", "build"] } },
          "exclusive": { "type": "integer", "minimum": 0 },
          "tree": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "policy": {
      "description": "Violations of the cargoscope.toml policy, or null when no policy is configured or checked.",
      "oneOf": [{ "type": "array", "items": { "$ref": "#/$defs/violation" } }, { "type": "null" }]
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "nullable_string": { "type": ["string", "null"] },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "nullable_date": {
      "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }]
    },
    "data_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "downloaded_on"],
      "properties": {
        "source": { "enum": ["RustSec", "crates.io"] },
        "downloaded_on": { "$ref": "#/$defs/nullable_date" }
      }
    },
    "package_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "path": {
      "description": "Shortest dependency chain from a root package to this package, or null when no root reaches it.",
      "oneOf": [
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/package_ref" } },
        { "type": "null" }
      ]
    },
    "advisory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "aliases", "title", "date", "url", "kind", "informational",
        "severity", "package", "patched", "path", "ignored_reason",
        "relevance", "relevance_reason"
      ],
      "properties": {
        "id": { "type": "string", "description": "Identifier taken from the advisory data, such as a RUSTSEC ID." },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "url": { "$ref": "#/$defs/nullable_string" },
        "kind": { "enum": ["vulnerability", "informational"] },
        "informational": {
          "description": "Informational category (unmaintained, unsound, notice...) or null for vulnerabilities.",
          "$ref": "#/$defs/nullable_string"
        },
        "severity": {
          "description": "Computed from the advisory's CVSS vector; null when it has none.",
          "enum": ["none", "low", "medium", "high", "critical", null]
        },
        "package": { "$ref": "#/$defs/package_ref" },
        "patched": {
          "description": "Version requirements that fix the advisory; empty when no fix exists.",
          "type": "array",
          "items": { "type": "string" }
        },
        "path": { "$ref": "#/$defs/path" },
        "ignored_reason": {
          "description": "Reason given in cargoscope.toml [advisories] ignore, or null. Ignored advisories never fail the scan.",
          "$ref": "#/$defs/nullable_string"
        },
        "relevance": {
          "description": "How likely the advisory is to affect the project's shipped code (since 0.8.0).",
          "enum": ["affects-you", "possibly", "unlikely"]
        },
        "relevance_reason": {
          "description": "Why relevance is `possibly` or `unlikely`, or null when `affects-you` (since 0.8.0).",
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "version", "scope", "direct", "source", "path", "license",
        "latest_version", "latest_published", "latest_compatible",
        "compatible_published", "outdated", "outdated_kind", "yanked",
        "last_release", "owners", "repository", "archived", "maintenance",
        "published", "unsafe", "audits"
      ],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "scope": { "enum": ["root", "direct", "transitive"] },
        "direct": { "type": "boolean" },
        "source": { "$ref": "#/$defs/nullable_string" },
        "path": { "$ref": "#/$defs/path" },
        "license": { "$ref": "#/$defs/nullable_string" },
        "latest_version": { "$ref": "#/$defs/nullable_string" },
        "latest_published": { "$ref": "#/$defs/nullable_date" },
        "latest_compatible": { "$ref": "#/$defs/nullable_string" },
        "compatible_published": { "$ref": "#/$defs/nullable_date" },
        "outdated": { "type": "boolean" },
        "outdated_kind": { "enum": ["none", "compatible", "breaking", "both"] },
        "yanked": { "type": ["boolean", "null"], "description": "null when no registry data is cached." },
        "last_release": { "$ref": "#/$defs/nullable_date", "description": "Date of the most recent non-yanked release of any version (since 0.7.0)." },
        "owners": {
          "type": ["array", "null"],
          "items": { "type": "string" },
          "description": "crates.io owners (teams as github:org:team); null when not downloaded. Fetched for direct dependencies only (since 0.7.0)."
        },
        "repository": { "$ref": "#/$defs/nullable_string", "description": "Repository URL; fetched for direct dependencies only (since 0.7.0)." },
        "archived": { "type": ["boolean", "null"], "description": "Whether the GitHub repository is archived; null when unknown or not on GitHub (since 0.7.0)." },
        "maintenance": {
          "type": "array",
          "items": { "enum": ["archived", "stale", "single-owner"] },
          "description": "Maintenance concerns: archived repository, no release for 2 years, single crates.io owner (since 0.7.0)."
        },
        "published": { "$ref": "#/$defs/nullable_string", "description": "Publication time of the resolved version, RFC 3339 UTC (a bare date in older caches); null when unknown (since 1.0.0)." },
        "unsafe": {
          "description": "Uses of `unsafe` in the package's sources on disk; null for workspace members and packages whose sources are not downloaded (since 1.0.0).",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["total", "blocks", "functions", "impls", "traits", "other"],
              "properties": {
                "total": { "type": "integer", "minimum": 0 },
                "blocks": { "type": "integer", "minimum": 0 },
                "functions": { "type": "integer", "minimum": 0 },
                "impls": { "type": "integer", "minimum": 0 },
                "traits": { "type": "integer", "minimum": 0 },
                "other": { "type": "integer", "minimum": 0 }
              }
            }
          ]
        },
        "audits": {
          "description": "Published cargo-vet audits of the resolved version, best criteria first: empty when no organisation audited it, null when no audits were downloaded (since 1.0.0).",
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["by", "criteria"],
            "properties": {
              "by": { "type": "string" },
              "criteria": { "enum": ["safe-to-deploy", "safe-to-run"] }
            }
          }
        }
      }
    },
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "level", "package", "message", "path"],
      "properties": {
        "rule": { "enum": ["license", "source", "ban", "multiple-versions"] },
        "level": { "enum": ["error", "warning"] },
        "package": { "$ref": "#/$defs/package_ref" },
        "message": { "type": "string" },
        "path": { "$ref": "#/$defs/path" }
      }
    },
    "unused": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency", "package", "section", "declared_by", "manifest",
        "confidence", "evidence", "ignored_reason"
      ],
      "properties": {
        "dependency": { "type": "string", "description": "Manifest key, also the name used in code." },
        "package": { "type": "string", "description": "Real crate name when renamed with `package = ...`." },
        "section": { "enum": ["dependencies", "dev-dependencies", "build-dependencies", "workspace.dependencies"] },
        "declared_by": { "type": "string" },
        "manifest": { "type": "string" },
        "confidence": { "enum": ["likely-unused", "possibly-unused"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "ignored_reason": { "$ref": "#/$defs/nullable_string" }
      }
    }
  }
}
